# AI 网关（OpenAI 兼容）
AI_BASE_URL=https://ai.buidlerdao.xyz/v1
AI_API_KEY=sk-xxxx
# 主回答模型
CHAT_MODEL=gpt-5.4
# 查询改写 / 历史压缩用的轻量模型
UTILITY_MODEL=deepseek-v4-flash

# Embedding 提供方: ollama(本地, 默认) | gateway(网关, 需要网关开通 embedding 渠道)
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=bge-m3
GATEWAY_EMBED_MODEL=text-embedding-3-small
